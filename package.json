    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"

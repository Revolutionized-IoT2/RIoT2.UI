    "@vue-flow/minimap": "^1.5.4",
    "axios": "^1.21.0",
    "chart.js": "^4.6.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "material-design-icons-iconfont": "^6.7.0",
    "mqtt": "^5.16.1",
    "pinia": "^4.1.0",
    "roboto-fontface": "^0.10.0",
    "uuid": "^14.0.3",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.4",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.4.0",
